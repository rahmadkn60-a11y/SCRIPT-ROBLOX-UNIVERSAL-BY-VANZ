        local function parseArgsString(s)
            if not s or s == "" then return {} end
            local out = {}
            local i, len = 1, #s
            while i <= len do
                while i <= len and s:sub(i, i):match("[%s,]") do i = i + 1 end
                if i > len then break end
                local c = s:sub(i, i)
                local val
                if c == '"' or c == "'" then
                    local q = c
                    i = i + 1
                    local buf = {}
                    while i <= len do
                        local cc = s:sub(i, i)
                        if cc == "\\" and i < len then buf[#buf + 1] = s:sub(i + 1, i + 1); i = i + 2
                        elseif cc == q then i = i + 1; break
                        else buf[#buf + 1] = cc; i = i + 1 end
                    end
                    val = table.concat(buf)
                else
                    local start = i
                    while i <= len and s:sub(i, i) ~= "," do i = i + 1 end
                    local raw = s:sub(start, i - 1):gsub("^%s+", ""):gsub("%s+$", "")
                    if raw == "" then val = ""
                    elseif raw == "true" then val = true
                    elseif raw == "false" then val = false
                    elseif raw == "nil" then val = nil
                    elseif tonumber(raw) then val = tonumber(raw)
                    else val = raw end
                end
                if val ~= nil then table.insert(out, val) end
            end
            return out
        end
        local function resolveInstance(path)
            if not path or path == "" then return nil end
            local cur = game
            local ok2 = pcall(function()
                for seg in path:gmatch("[^%.]+") do
                    if seg == "ReplicatedStorage" or seg == "Workspace" or seg == "Players" or seg == "CoreGui" or seg == "ServerStorage" or seg == "StarterGui" or seg == "StarterPack" or seg == "Chat" or seg == "Teams" then
                        cur = game:GetService(seg)
