        local function pushLog(msg)
            local text = os.date("%H:%M:%S ") .. tostring(msg)
            table.insert(V.log, {text = text})
            if #V.log > 3000 then table.remove(V.log, 1) end
            if V.activeTab ~= "log" then return end
            if not V.LogScroll or not V.LogScroll.Parent then return end
            table.insert(V.logQueue, text)
            if V._logFlush then return end
            V._logFlush = true
            task.delay(0.15, function()
                V._logFlush = false
                if not V.LogScroll or not V.LogScroll.Parent or V.activeTab ~= "log" then
                    V.logQueue = {}
                    return
                end
                local batch = V.logQueue
                V.logQueue = {}
                for _, t in ipairs(batch) do
                    local lbl = Instance.new("TextLabel")
                    lbl.Size = UDim2.new(1, -8, 0, 0)
                    lbl.AutomaticSize = Enum.AutomaticSize.Y
                    lbl.BackgroundTransparency = 1
                    lbl.Text = t
                    lbl.TextColor3 = Color3.fromRGB(200, 200, 220)
                    lbl.Font = Enum.Font.Code
                    lbl.TextSize = 9
                    lbl.TextWrapped = true
                    lbl.TextXAlignment = Enum.TextXAlignment.Left
                    lbl.TextYAlignment = Enum.TextYAlignment.Top
                    lbl.Parent = V.LogScroll
                end
            end)
        end
