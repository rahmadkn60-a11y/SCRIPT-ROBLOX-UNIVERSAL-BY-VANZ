            table.insert(lines, "ManualProbe: " .. #(self.manualResults or {}))
            table.insert(lines, "Chains     : " .. #(self.chains or {}))
            table.insert(lines, "Shoot      : " .. #(self.shootResults or {}))
            table.insert(lines, "============================================")
            table.insert(lines, "")
            if self.manualResults and #self.manualResults > 0 then
                table.insert(lines, "============ MANUAL PROBE RESULTS ============")
                table.insert(lines, "")
                local byRemote = {}
                for _, r in ipairs(self.manualResults) do
                    byRemote[r.remote] = byRemote[r.remote] or {}
                    table.insert(byRemote[r.remote], r)
                end
                local sorted = {}
                for k in pairs(byRemote) do table.insert(sorted, k) end
                table.sort(sorted)
                for _, key in ipairs(sorted) do
                    local list = byRemote[key]
                    local okc, errc, dltc = 0, 0, 0
                    for _, f in ipairs(list) do
                        if f.status == "OK" then okc = okc + 1 else errc = errc + 1 end
                        if f.delta and #f.delta > 0 then dltc = dltc + 1 end
                    end
                    table.insert(lines, "Remote:")
                    table.insert(lines, "    " .. key)
                    table.insert(lines, string.format("Result: OK=%d ERROR=%d DELTA=%d", okc, errc, dltc))
                    table.insert(lines, "")
                    for _, f in ipairs(list) do
                        local line = string.format("    #%d [%s] latency=%.0fms", f.iteration, f.status, f.latency or 0)
                        table.insert(lines, line)
                        if f.delta and #f.delta > 0 then
                            table.insert(lines, "        delta: " .. table.concat(f.delta, ", "))
                        end
                        if f.response ~= nil then
                            table.insert(lines, "        resp: " .. fmtVal(f.response):sub(1, 80))
                        end
                        if f.error then
                            table.insert(lines, "        err: " .. tostring(f.error):sub(1, 80))
                        end
                    end
                    table.insert(lines, "")
                    table.insert(lines, "--------------------------------------------")
                    table.insert(lines, "")
                end
            end
            table.insert(lines, "============ HEURISTIC CANDIDATES ============")
            table.insert(lines, "")
            local hByRemote = {}
            for _, r in ipairs(self.testResults or {}) do
                hByRemote[r.remote] = hByRemote[r.remote] or {}
                table.insert(hByRemote[r.remote], r)
            end
            local hSorted = {}
            for k in pairs(hByRemote) do table.insert(hSorted, k) end
            table.sort(hSorted)
            for _, key in ipairs(hSorted) do
                table.insert(lines, "Remote:")
                table.insert(lines, "    " .. key)
                for _, r in ipairs(hByRemote[key]) do
                    table.insert(lines, string.format("    [%s] %s", r.severity, r.test))
                end
                table.insert(lines, "")
            end
            if self.chains and #self.chains > 0 then
                table.insert(lines, "============ CHAIN LINKS ============")
                table.insert(lines, "")
                for i = 1, math.min(#self.chains, 20) do
                    table.insert(lines, "    " .. self.chains[i].pair .. " x" .. self.chains[i].count)
                end
                table.insert(lines, "")
            end
            if self.shootResults and #self.shootResults > 0 then
                table.insert(lines, "============ SHOOT RESULTS ============")
                table.insert(lines, "")
                local sByR = {}
                for _, r in ipairs(self.shootResults) do
                    sByR[r.remote] = sByR[r.remote] or {}
                    table.insert(sByR[r.remote], r)
                end
                local sS = {}
                for k in pairs(sByR) do table.insert(sS, k) end
                table.sort(sS)
                for _, key in ipairs(sS) do
                    table.insert(lines, "Remote: " .. key)
                    for _, r in ipairs(sByR[key]) do
                        local line = "    [" .. r.status .. "] " .. r.payload_name
                        if r.delta and #r.delta > 0 then
                            line = line .. " | " .. table.concat(r.delta, ", ")
                        end
                        table.insert(lines, line)
                    end
                    table.insert(lines, "")
                end
            end
            table.insert(lines, "============================================")
            table.insert(lines, "END OF REPORT")
            table.insert(lines, "============================================")
            self.report = table.concat(lines, "\n")
            if self.ReportBox then self.ReportBox.Text = self.report end
            self.pushLog("[9] DONE: report (" .. #self.report .. " chars)")
            if self.autoCopyReport then
                pcall(function()
                    if setclipboard then
                        setclipboard(self.report)
                        self.pushLog("[+] AUTO-COPY: report copied")
                    end
                end)
            end
            self.setStage(9, "done")
            return self.report
        end
    end)
    if not ok then warn("[VANZ] BLOK 12 error: " .. tostring(err)) end
    print("[VANZ] BLOK 12 done")
end

