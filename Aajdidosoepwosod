        local function sim(contract, test)
            local at = contract.argTypes or {}
            local cc = contract.callCount or 0
            local result, sev = "SKIP", "INFO"
            if test.name == "type mismatch" then
                for _ in pairs(at) do result = "CHECK"; sev = "MEDIUM"; break end
            elseif test.name == "arg count variance" then
                local k = 0
                for _ in pairs(at) do k = k + 1 end
