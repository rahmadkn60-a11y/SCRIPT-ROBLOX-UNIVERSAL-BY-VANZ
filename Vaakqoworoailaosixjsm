do
    print("[VANZ] BLOK 4 start")
    local ok, err = pcall(function()
        local V = _G.vanz
        if not V then return end

        local function fmtArg(a)
            local t = typeof(a)
            if t == "string" then
                return '"' .. tostring(a):sub(1, 60) .. '"'
            elseif t == "number" then
                return tostring(a)
            elseif t == "boolean" then
                return tostring(a)
            elseif t == "Instance" then
                local ok2, n = pcall(function() return a:GetFullName() end)
                return ok2 and n or (a.Name or "Instance")
            elseif t == "table" then
                return "[table]"
            elseif t == "Vector3" then
                return string.format("V3(%.1f,%.1f,%.1f)", a.X, a.Y, a.Z)
            elseif t == "CFrame" then
                local p = a.Position
                return string.format("CF(%.1f,%.1f,%.1f)", p.X, p.Y, p.Z)
            else
                return tostring(a)
            end
        end

        local function record(name, method, args)
            local entry = {
                remote = name,
                method = method,
                args = args,
                time = os.time(),
            }
            table.insert(V.log, entry)
            if #V.log > 1000 then table.remove(V.log, 1) end
            if not V.pushLog then return end
            V.pushLog("[2] " .. name .. " [" .. method .. "]")
            for i = 1, #args do
                V.pushLog("  " .. i .. " = " .. fmtArg(args[i]))
            end
        end

        V.loggerHooked = false

        if getrawmetatable and setreadonly and newcclosure and getnamecallmethod then
            local ok2, err2 = pcall(function()
                local mt = getrawmetatable(game)
                if not mt then error("metatable nil") end
                local oldNamecall = mt.__namecall
                if not oldNamecall then error("__namecall nil") end
                setreadonly(mt, false)
                mt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    if (method == "FireServer" or method == "InvokeServer")
                        and (V.loggerEnabled or V.autoScanRunning) then
                        local args = {...}
                        if method == "InvokeServer" then
                            local result = oldNamecall(self, ...)
                            pcall(function()
                                local name = "?"
                                pcall(function() name = self:GetFullName() end)
                                record(name, method, args)
                            end)
                            return result
                        else
                            pcall(function()
                                local name = "?"
                                pcall(function() name = self:GetFullName() end)
                                record(name, method, args)
                            end)
                        end
                    end
                    return oldNamecall(self, ...)
                end)
                setreadonly(mt, true)
                V.loggerHooked = true
            end)
            if not ok2 then warn("[VANZ] raw hook fail: " .. tostring(err2)) end
        end

        if not V.loggerHooked and hookmetamethod and newcclosure and getnamecallmethod then
            local ok2, err2 = pcall(function()
                local ref = {old = nil}
                local wrapped = newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    if (method == "FireServer" or method == "InvokeServer")
                        and (V.loggerEnabled or V.autoScanRunning) then
                        local args = {...}
                        if ref.old then
                            if method == "InvokeServer" then
                                local result = ref.old(self, ...)
                                pcall(function()
                                    local name = "?"
                                    pcall(function() name = self:GetFullName() end)
                                    record(name, method, args)
                                end)
                                return result
                            else
                                pcall(function()
                                    local name = "?"
                                    pcall(function() name = self:GetFullName() end)
                                    record(name, method, args)
                                end)
                            end
                        end
                    end
                    if ref.old then return ref.old(self, ...) end
                end)
                ref.old = hookmetamethod(game, "__namecall", wrapped)
                if ref.old then
                    V.loggerHooked = true
                else
                    error("hookmetamethod return nil")
                end
            end)
            if not ok2 then warn("[VANZ] hookmetamethod fail: " .. tostring(err2)) end
        end

        if not V.loggerHooked then
            warn("[VANZ] Logger TIDAK ter-hook")
        end
    end)
    if not ok then warn("[VANZ] BLOK 4 error: " .. tostring(err)) end
    print("[VANZ] BLOK 4 done, hooked=" .. tostring(_G.vanz and _G.vanz.loggerHooked))
end

