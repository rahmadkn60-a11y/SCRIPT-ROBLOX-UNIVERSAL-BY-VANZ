-- BLOCK 6 : CONTROLS (copy/run/reset, minimize, drag, top tabs)
do
    _G.vanz.run("CONTROLS", function()
        local V = _G.vanz
        local C = V.C
        local UIS = game:GetService("UserInputService")

        -- TOP TABS (Outgoing/Incoming) — visual only
        V.UI.outTab.TextColor3 = C.text
        V.UI.outTab.MouseButton1Click:Connect(function()
            V.State.tab = "Outgoing"
            V.UI.outTab.TextColor3 = C.text
            V.UI.inTab.TextColor3 = C.textDim
        end)
        V.UI.inTab.MouseButton1Click:Connect(function()
            V.State.tab = "Incoming"
            V.UI.outTab.TextColor3 = C.textDim
            V.UI.inTab.TextColor3 = C.text
        end)

        -- COPY
        V.UI.copyBtn.MouseButton1Click:Connect(function()
            local text = V.UI.codeBox.Text or ""
            if text == "" then return end
            local fn, name = V.clipboard()
            if fn then
                if pcall(fn, text) then
                    V.UI.copyBtn.Text = "COPIED ✓"
                    task.delay(1, function() V.UI.copyBtn.Text = "COPY" end)
                    return
                end
            end
            -- fallback select
            V.UI.codeBox:CaptureFocus()
            task.wait(0.05)
            V.UI.codeBox.CursorPosition = #text + 1
            V.UI.codeBox.SelectionStart = 1
            V.UI.copyBtn.Text = "SELECTED"
            task.delay(1, function() V.UI.copyBtn.Text = "COPY" end)
        end)

        -- RUN
        V.UI.runBtn.MouseButton1Click:Connect(function()
            local code = V.UI.codeBox.Text or ""
            if code == "" then return end
            local loader = loadstring or load
            if type(loader) ~= "function" then
                V.UI.runBtn.Text = "NO LOADSTRING"
                task.delay(1, function() V.UI.runBtn.Text = "RUN" end)
                return
            end
            local fn, err = loader(code)
            if not fn then
                warn("[VANZ RUN] parse: " .. tostring(err))
                V.UI.runBtn.Text = "PARSE ERR"
                task.delay(1, function() V.UI.runBtn.Text = "RUN" end)
                return
            end
            local ok, e = pcall(fn)
            if ok then
                V.UI.runBtn.Text = "OK ✓"
            else
                warn("[VANZ RUN] " .. tostring(e))
                V.UI.runBtn.Text = "RUN ERR"
            end
            task.delay(1, function() V.UI.runBtn.Text = "RUN" end)
        end)

        -- RESET
        V.UI.resetBtn.MouseButton1Click:Connect(function()
            if V.State.codeCache and V.State.codeCache ~= "" then
                V.UI.codeBox.Text = V.State.codeCache
                V.UI.resetBtn.Text = "RESET ✓"
                task.delay(0.8, function() V.UI.resetBtn.Text = "RESET" end)
            end
        end)

        -- DRAG MAIN via header
        local main = V.UI.main
        local header = V.UI.header
        local minBtn = V.UI.minBtn
        local closeBtn = V.UI.closeBtn

        local function isOverHdrBtn(pos)
            for _, b in ipairs({minBtn, closeBtn}) do
                local ap, as = b.AbsolutePosition, b.AbsoluteSize
                if pos.X >= ap.X and pos.X <= ap.X + as.X
                   and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y then
                    return true
                end
            end
            return false
        end

        local dMain, dStart, dPos, dInput
        header.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
               and input.UserInputType ~= Enum.UserInputType.Touch then return end
            if isOverHdrBtn(input.Position) then return end
            dMain = true
            dStart = input.Position
            dPos = main.Position
            dInput = input
        end)
        header.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
               or input.UserInputType == Enum.UserInputType.Touch then
                dInput = input
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if not dMain or input ~= dInput then return end
            local d = input.Position - dStart
            main.Position = UDim2.new(
                dPos.X.Scale, dPos.X.Offset + d.X,
                dPos.Y.Scale, dPos.Y.Offset + d.Y
            )
        end)
        UIS.InputEnded:Connect(function(input)
            if input == dInput then dMain = false end
        end)

        -- MINIMIZE
        minBtn.MouseButton1Click:Connect(function()
            main.Visible = false
            V.UI.logo.Visible = true
            V.UI.logo.Position = UDim2.new(0.5, -24, 0.5, -24)
        end)

        -- CLOSE
        closeBtn.MouseButton1Click:Connect(function()
            if V.unhook then V.unhook() end
            V.UI.gui:Destroy()
        end)

        -- LOGO drag + klik restore
        local logo = V.UI.logo
        local lDrag, lStart, lPos, lInput, lMoved

        logo.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
               and input.UserInputType ~= Enum.UserInputType.Touch then return end
            lDrag = true
            lMoved = 0
            lStart = input.Position
            lPos = logo.Position
            lInput = input
        end)
        logo.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
               or input.UserInputType == Enum.UserInputType.Touch then
                lInput = input
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if not lDrag or input ~= lInput then return end
            local d = input.Position - lStart
            lMoved = d.Magnitude
            logo.Position = UDim2.new(
                lPos.X.Scale, lPos.X.Offset + d.X,
                lPos.Y.Scale, lPos.Y.Offset + d.Y
            )
        end)
        UIS.InputEnded:Connect(function(input)
            if not lDrag or input ~= lInput then return end
            lDrag = false
            if lMoved < 8 then
                logo.Visible = false
                main.Visible = true
            end
        end)
    end)
end


