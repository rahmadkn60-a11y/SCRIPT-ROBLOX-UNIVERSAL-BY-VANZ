-- BLOCK 5 : BUILD UI LOGIC (list + right panel + open modal)
do
    _G.vanz.run("UI_LOGIC", function()
        local V = _G.vanz
        local C = V.C
        local listScroll = V.UI.listScroll
        local rightScroll = V.UI.rightScroll

        local rows = {}
        V.rows = rows

        -- PATH → CODE
        local function pathToCode(fullPath)
            local service = fullPath:match("^([^%.]+)")
            if not service then return "nil" end
            local known = {
                ReplicatedStorage = true, ReplicatedFirst = true,
                Workspace = true, Players = true, Lighting = true,
                SoundService = true, StarterGui = true, StarterPack = true,
                StarterPlayer = true, Chat = true, Teams = true,
            }
            if known[service] then
                return 'game:GetService("' .. service .. '").' .. fullPath:sub(#service + 2)
            end
            return fullPath
        end
        V.pathToCode = pathToCode

        -- ROW BUILDER
        local function buildRow(entry)
            local row = Instance.new("TextButton")
            row.Size = UDim2.new(1, 0, 0, 30)
            row.BackgroundColor3 = C.row
            row.BorderSizePixel = 0
            row.AutoButtonColor = false
            row.Text = ""
            row.Parent = listScroll
            local c = Instance.new("UICorner")
            c.CornerRadius = UDim.new(0, 5); c.Parent = row

            local icon = Instance.new("TextLabel")
            icon.Position = UDim2.fromOffset(6, 0)
            icon.Size = UDim2.fromOffset(18, 30)
            icon.BackgroundTransparency = 1
            icon.Font = Enum.Font.GothamBold
            icon.Text = "⚡"
            icon.TextSize = 13
            icon.TextColor3 = C.orange
            icon.Parent = row

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Position = UDim2.fromOffset(28, 0)
            nameLbl.Size = UDim2.new(1, -80, 1, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Font = Enum.Font.Gotham
            nameLbl.Text = entry.name
            nameLbl.TextSize = 11
            nameLbl.TextColor3 = C.text
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
            nameLbl.Parent = row

            local countLbl = Instance.new("TextLabel")
            countLbl.AnchorPoint = Vector2.new(1, 0.5)
            countLbl.Position = UDim2.new(1, -8, 0.5, 0)
            countLbl.Size = UDim2.fromOffset(60, 20)
            countLbl.BackgroundTransparency = 1
            countLbl.Font = Enum.Font.Gotham
            countLbl.Text = "x0"
            countLbl.TextSize = 10
            countLbl.TextColor3 = C.textDim
            countLbl.TextXAlignment = Enum.TextXAlignment.Right
            countLbl.Parent = row

            row.MouseButton1Click:Connect(function()
                for _, r in pairs(rows) do
                    r.row.BackgroundColor3 = C.row
                end
                row.BackgroundColor3 = C.rowSel
                V.State.selected = entry
                V.renderRight(entry)
            end)

            return { row = row, countLbl = countLbl, entry = entry }
        end

        function V.onRemoteNew(entry)
            local r = buildRow(entry)
            rows[entry] = r
            if not V.State.selected then
                r.row.BackgroundColor3 = C.rowSel
                V.State.selected = entry
                V.renderRight(entry)
            end
        end

        function V.onRemoteUpdate(entry)
            local r = rows[entry]
            if r then
                r.countLbl.Text = "x" .. #entry.calls
            end
        end

        -- RENDER RIGHT PANEL
        function V.renderRight(entry)
            for _, ch in ipairs(rightScroll:GetChildren()) do
                if ch:IsA("TextButton") or ch:IsA("Frame") or ch:IsA("TextLabel") then
                    ch:Destroy()
                end
            end

            if not entry then return end
            local calls = entry.calls or {}
            if #calls == 0 then
                local empty = Instance.new("TextLabel")
                empty.Size = UDim2.new(1, 0, 0, 30)
                empty.BackgroundTransparency = 1
                empty.Font = Enum.Font.Gotham
                empty.Text = "Belum ada call"
                empty.TextSize = 10
                empty.TextColor3 = C.textDim
                empty.Parent = rightScroll
                return
            end

            local start = math.max(1, #calls - 49)
            for i = start, #calls do
                local call = calls[i]
                local card = Instance.new("TextButton")
                card.Size = UDim2.new(1, 0, 0, 34)
                card.BackgroundColor3 = C.row
                card.BorderSizePixel = 0
                card.AutoButtonColor = false
                card.Text = ""
                card.Parent = rightScroll
                local c = Instance.new("UICorner")
                c.CornerRadius = UDim.new(0, 5); c.Parent = card

                local num = Instance.new("TextLabel")
                num.Position = UDim2.fromOffset(8, 0)
                num.Size = UDim2.fromOffset(20, 34)
                num.BackgroundTransparency = 1
                num.Font = Enum.Font.GothamBold
                num.Text = tostring(i)
                num.TextSize = 10
                num.TextColor3 = C.textDim
                num.TextXAlignment = Enum.TextXAlignment.Left
                num.Parent = card

                local n = #call.args
                local previewText
                if n == 0 then
                    previewText = "-- no args"
                elseif n == 1 then
                    previewText = V.shortPreview(call.args[1])
                else
                    local parts = {}
                    for j = 1, math.min(n, 2) do
                        parts[#parts+1] = V.shortPreview(call.args[j])
                    end
                    previewText = table.concat(parts, ", ")
                    if n > 2 then previewText = previewText .. " …" end
                end

                local prev = Instance.new("TextLabel")
                prev.Position = UDim2.fromOffset(30, 0)
                prev.Size = UDim2.new(1, -110, 1, 0)
                prev.BackgroundTransparency = 1
                prev.Font = Enum.Font.Code
                prev.Text = previewText
                prev.TextSize = 10
                prev.TextColor3 = C.codeYel
                prev.TextXAlignment = Enum.TextXAlignment.Left
                prev.TextTruncate = Enum.TextTruncate.AtEnd
                prev.Parent = card

                local badge = Instance.new("TextLabel")
                badge.AnchorPoint = Vector2.new(1, 0.5)
                badge.Position = UDim2.new(1, -8, 0.5, 0)
                badge.Size = UDim2.fromOffset(80, 20)
                badge.BackgroundTransparency = 1
                badge.Font = Enum.Font.Gotham
                badge.Text = (n == 1) and V.typeOf(call.args[1]) or (n .. " args")
                badge.TextSize = 9
                badge.TextColor3 = C.textDim
                badge.TextXAlignment = Enum.TextXAlignment.Right
                badge.Parent = card

                card.MouseButton1Click:Connect(function()
                    V.openModal(entry, call)
                end)
            end
        end

        -- OPEN MODAL
        function V.openModal(entry, call)
            V.State.modal = { entry = entry, call = call }
            V.UI.mTitle.Text = entry.name
            V.UI.overlay.Visible = true
            V.State.modalTab = "Args"
            V.refreshModalTabs()

            local argsView = V.UI.argsView
            for _, ch in ipairs(argsView:GetChildren()) do
                if ch:IsA("Frame") then ch:Destroy() end
            end

            local n = #call.args
            if n == 0 then
                local empty = Instance.new("TextLabel")
                empty.Size = UDim2.new(1, 0, 0, 30)
                empty.BackgroundTransparency = 1
                empty.Font = Enum.Font.Gotham
                empty.Text = "-- No arguments"
                empty.TextSize = 10
                empty.TextColor3 = C.textDim
                empty.Parent = argsView
            else
                for i = 1, n do
                    local argCard = Instance.new("Frame")
                    argCard.Size = UDim2.new(1, 0, 0, 34)
                    argCard.BackgroundColor3 = C.row
                    argCard.BorderSizePixel = 0
                    argCard.Parent = argsView
                    local ac = Instance.new("UICorner")
                    ac.CornerRadius = UDim.new(0, 5); ac.Parent = argCard

                    local num = Instance.new("TextLabel")
                    num.Position = UDim2.fromOffset(8, 0)
                    num.Size = UDim2.fromOffset(20, 34)
                    num.BackgroundTransparency = 1
                    num.Font = Enum.Font.GothamBold
                    num.Text = tostring(i)
                    num.TextSize = 11
                    num.TextColor3 = C.textDim
                    num.TextXAlignment = Enum.TextXAlignment.Left
                    num.Parent = argCard

                    local val = Instance.new("TextLabel")
                    val.Position = UDim2.fromOffset(32, 0)
                    val.Size = UDim2.new(1, -110, 1, 0)
                    val.BackgroundTransparency = 1
                    val.Font = Enum.Font.Code
                    val.Text = V.shortPreview(call.args[i])
                    val.TextSize = 10
                    val.TextColor3 = C.codeYel
                    val.TextXAlignment = Enum.TextXAlignment.Left
                    val.TextTruncate = Enum.TextTruncate.AtEnd
                    val.Parent = argCard

                    local tBadge = Instance.new("TextLabel")
                    tBadge.AnchorPoint = Vector2.new(1, 0.5)
                    tBadge.Position = UDim2.new(1, -8, 0.5, 0)
                    tBadge.Size = UDim2.fromOffset(80, 20)
                    tBadge.BackgroundTransparency = 1
                    tBadge.Font = Enum.Font.Gotham
                    tBadge.Text = V.typeOf(call.args[i])
                    tBadge.TextSize = 9
                    tBadge.TextColor3 = C.textDim
                    tBadge.TextXAlignment = Enum.TextXAlignment.Right
                    tBadge.Parent = argCard
                end
            end

            -- CODE
            local codeLines = {}
            table.insert(codeLines, "-- Generated by VANZ Cobalt")
            table.insert(codeLines, "-- Remote: " .. entry.path)
            table.insert(codeLines, "-- Method: " .. call.method)
            table.insert(codeLines, "")
            table.insert(codeLines, "local Event = " .. pathToCode(entry.path))
            table.insert(codeLines, "")
            if n == 0 then
                table.insert(codeLines, "Event:" .. call.method .. "()")
            else
                table.insert(codeLines, "Event:" .. call.method .. "(")
                for i = 1, n do
                    local code = V.toCode(call.args[i], "    ")
                    local sep = (i < n) and "," or ""
                    table.insert(codeLines, "    " .. code .. sep)
                end
                table.insert(codeLines, ")")
            end

            local codeStr = table.concat(codeLines, "\n")
            V.State.codeCache = codeStr
            V.UI.codeBox.Text = codeStr

            -- FUNC INFO
            local funcView = V.UI.funcView
            for _, ch in ipairs(funcView:GetChildren()) do
                if ch:IsA("Frame") then ch:Destroy() end
            end

            local function addRow(label, value)
                local row = Instance.new("Frame")
                row.Size = UDim2.new(1, 0, 0, 28)
                row.BackgroundColor3 = C.row
                row.BorderSizePixel = 0
                row.Parent = funcView
                local rc = Instance.new("UICorner")
                rc.CornerRadius = UDim.new(0, 5); rc.Parent = row

                local lbl = Instance.new("TextLabel")
                lbl.Position = UDim2.fromOffset(10, 0)
                lbl.Size = UDim2.fromOffset(90, 28)
                lbl.BackgroundTransparency = 1
                lbl.Font = Enum.Font.GothamBold
                lbl.Text = label
                lbl.TextSize = 10
                lbl.TextColor3 = C.textDim
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.Parent = row

                local v = Instance.new("TextLabel")
                v.Position = UDim2.fromOffset(105, 0)
                v.Size = UDim2.new(1, -115, 1, 0)
                v.BackgroundTransparency = 1
                v.Font = Enum.Font.Code
                v.Text = tostring(value)
                v.TextSize = 10
                v.TextColor3 = C.text
                v.TextXAlignment = Enum.TextXAlignment.Left
                v.TextTruncate = Enum.TextTruncate.AtEnd
                v.Parent = row
            end

            addRow("Name", entry.name)
            addRow("Path", entry.path)
            addRow("Class", entry.class)
            addRow("Method", call.method)
            addRow("Time", call.time)
            addRow("Args count", tostring(n))
            addRow("Total calls", tostring(#entry.calls))
        end
    end)
end


