-- BLOCK 1 : SERIALIZE + CLIPBOARD
do
    _G.vanz.run("SERIALIZE", function()
        local V = _G.vanz

        local function tryEnv(env)
            if type(env) ~= "table" then return nil end
            for _, n in ipairs({"setclipboard","toclipboard","toClipboard","writeclipboard","writeClipboard"}) do
                if type(env[n]) == "function" then return env[n], n end
            end
        end
        function V.clipboard()
            if type(getgenv) == "function" then
                local ok, e = pcall(getgenv)
                if ok and e then local f, n = tryEnv(e) if f then return f, n end end
            end
            local f, n = tryEnv(_G)
            if f then return f, n end
            return nil, nil
        end

        local function typeOf(v)
            if typeof then
                local ok, t = pcall(function() return typeof(v) end)
                if ok then return t end
            end
            return type(v)
        end
        V.typeOf = typeOf

        -- Value → Lua code
        local function toCode(v, indent)
            indent = indent or ""
            local t = type(v)
            if t == "nil" then return "nil" end
            if t == "boolean" then return tostring(v) end
            if t == "number" then
                if v ~= v then return "0/0" end
                if v == math.huge then return "math.huge" end
                if v == -math.huge then return "-math.huge" end
                return tostring(v)
            end
            if t == "string" then return string.format("%q", v) end
            if t == "function" then return "function() end" end
            if t == "thread" then return "coroutine.create(function() end)" end
            if t == "userdata" then
                if typeof then
                    local ok, rt = pcall(function() return typeof(v) end)
                    if ok and rt == "Instance" then
                        local ok2, n = pcall(function() return v:GetFullName() end)
                        return n or "nil"
                    end
                end
                return "newproxy(false)"
            end
            if t == "table" then
                if typeof then
                    local ok, rt = pcall(function() return typeof(v) end)
                    if ok and rt and rt ~= "table" then
                        if rt == "Vector3" then return string.format("Vector3.new(%f,%f,%f)", v.X, v.Y, v.Z) end
                        if rt == "Vector2" then return string.format("Vector2.new(%f,%f)", v.X, v.Y) end
                        if rt == "CFrame" then
                            local x,y,z,R00,R01,R02,R10,R11,R12,R20,R21,R22 = v:GetComponents()
                            return string.format(
                                "CFrame.new(%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s)",
                                tostring(x), tostring(y), tostring(z),
                                tostring(R00), tostring(R01), tostring(R02),
                                tostring(R10), tostring(R11), tostring(R12),
                                tostring(R20), tostring(R21), tostring(R22))
                        end
                        if rt == "Color3" then
                            return string.format("Color3.fromRGB(%d,%d,%d)",
                                math.floor(v.R*255+0.5), math.floor(v.G*255+0.5), math.floor(v.B*255+0.5))
                        end
                        if rt == "UDim2" then return string.format("UDim2.new(%f,%d,%f,%d)", v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset) end
                        if rt == "UDim" then return string.format("UDim.new(%f,%d)", v.Scale, v.Offset) end
                        if rt == "Instance" then
                            local ok2, n = pcall(function() return v:GetFullName() end)
                            return n or "nil"
                        end
                        if rt == "EnumItem" then return "Enum."..tostring(v.EnumType).."."..v.Name end
                        if rt == "BrickColor" then return "BrickColor.new(\""..v.Name.."\")" end
                        if rt == "NumberRange" then return string.format("NumberRange.new(%f,%f)", v.Min, v.Max) end
                        if rt == "Rect" then return string.format("Rect.new(%d,%d,%d,%d)", v.Min.X, v.Min.Y, v.Max.X, v.Max.Y) end
                        if rt == "TweenInfo" then return "TweenInfo.new(1)" end
                        return "nil -- [unsupported: " .. tostring(rt) .. "]"
                    end
                end
                local parts = {}
                for k, vv in pairs(v) do
                    local key
                    if type(k) == "string" and k:match("^[%a_][%w_]*$") then key = k
                    elseif type(k) == "number" then key = "["..tostring(k).."]"
                    else key = "["..toCode(k).."]" end
                    parts[#parts+1] = indent .. "    " .. key .. " = " .. toCode(vv, indent.."    ")
                end
                if #parts == 0 then return "{}" end
                return "{\n" .. table.concat(parts, ",\n") .. "\n" .. indent .. "}"
            end
            return "nil"
        end
        V.toCode = toCode

        function V.shortPreview(v)
            local rt = typeOf(v)
            if rt == "CFrame" then
                local x,y,z = v:GetComponents()
                return string.format("%.3f, %.3f, %.3f, ...", x, y, z)
            end
            if rt == "Vector3" then return string.format("%.3f, %.3f, %.3f", v.X, v.Y, v.Z) end
            if rt == "Vector2" then return string.format("%.3f, %.3f", v.X, v.Y) end
            if rt == "Instance" then
                local ok, n = pcall(function() return v:GetFullName() end)
                return ok and n or "Instance"
            end
            if type(v) == "string" then
                local s = string.format("%q", v)
                if #s > 60 then s = s:sub(1,60).."..." end
                return s
            end
            local s = tostring(v)
            if #s > 60 then s = s:sub(1,60).."..." end
            return s
        end
    end)
end


