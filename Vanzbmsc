--========================================================--
-- 6_FIRETOF v13 — pure prediction (no gravity)
--========================================================--
do
    xpcall(function()
        local Players     = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        local RS          = game:GetService("ReplicatedStorage")
        local cfg         = _G.vanz.AimCfg

        local function GetGunPart()
            local char = LocalPlayer.Character
            if not char then return nil end
            local tof = char:FindFirstChild("Twist of Fate")
            if tof then
                local rightArm = tof:FindFirstChild("Right Arm")
                if rightArm then
                    local g = rightArm:FindFirstChild("gun")
                        or rightArm:FindFirstChildWhichIsA("BasePart", true)
                    if g then return g end
                end
            end
            -- fallback: cari part bernama "gun" di seluruh character
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("BasePart") and d.Name:lower():find("gun") then return d end
            end
            return nil
        end

        local function GetAimOrigin()
            local char = LocalPlayer.Character
            if not char then return nil end
            local mode = cfg.originMode or "gun"
            if mode == "gun" then
                local gun = GetGunPart()
                if gun then return gun.Position end
            end
            if mode == "head" then
                local head = char:FindFirstChild("Head")
                if head and head:IsA("BasePart") then return head.Position end
            end
            local hrp = char:FindFirstChild("HumanoidRootPart")
                or char:FindFirstChild("UpperTorso")
                or char:FindFirstChild("Torso")
            return hrp and hrp.Position or nil
        end

        local function GetTargetPart()
            local tgt = _G.vanz.Runtime.Target
            if not tgt then return nil end
            local char = tgt.Character
            if not char then return nil end
            local priority = cfg.bonePriority
                or { "Head","UpperTorso","LowerTorso","HumanoidRootPart","Torso" }
            for _, name in ipairs(priority) do
                local p = char:FindFirstChild(name)
                if p and p:IsA("BasePart") then return p end
            end
            return nil
        end

        local function GetBulletSpeed()
            local s = cfg.bulletSpeed
            if typeof(s) == "number" and s > 0 then return s end
            return 220
        end

        local function GetEffectiveIterations()
            local base   = cfg.leadIterations or 128
            local minHi  = cfg.minFPSForMaxIter or 50
            local minMid = cfg.minFPSForMidIter or 32
            local minLo  = cfg.minFPSForLowIter or 18
            local emerg  = cfg.emergencyIter or 12
            local fps    = _G.vanz.Runtime.SmoothFPS or 60
            if not cfg.autoCycleIter then return base end
            if fps >= minHi  then return base                end
            if fps >= minMid then return math.min(base, 64)  end
            if fps >= minLo  then return math.min(base, 24)  end
            return emerg
        end

        local function GetTargetVelAccel(plr, part)
            if _G.vanz.SampleNow and plr then _G.vanz.SampleNow(plr) end
            local directVel = Vector3.zero
            if part then
                local ok, av = pcall(function() return part.AssemblyLinearVelocity end)
                if ok and av then directVel = av end
                if directVel.Magnitude < 0.05 then
                    local ok2, v2 = pcall(function() return part.Velocity end)
                    if ok2 and v2 then directVel = v2 end
                end
            end
            local tv = _G.vanz.GetPlayerVelocity and _G.vanz.GetPlayerVelocity(plr)
                or Vector3.zero
            local ta = _G.vanz.GetPlayerAccel and _G.vanz.GetPlayerAccel(plr)
                or Vector3.zero
            local dm, tm = directVel.Magnitude, tv.Magnitude
            local fused
            if dm > tm * 1.5 then fused = directVel
            elseif tm > dm * 1.5 then fused = tv
            else fused = (directVel + tv) * 0.5 end
            return fused, ta
        end

        local function HasLineOfSight(origin, targetPos)
            if not cfg.losCheck then return true end
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.IgnoreWater = true
            local filter = {}
            if cfg.losIgnoreSelf and LocalPlayer.Character then
                table.insert(filter, LocalPlayer.Character)
            end
            if _G.vanz.Runtime.Target and _G.vanz.Runtime.Target.Character then
                table.insert(filter, _G.vanz.Runtime.Target.Character)
            end
            params.FilterDescendantsInstances = filter
            local hit = workspace:Raycast(origin, targetPos - origin, params)
            return hit == nil
        end

        local function IsWallbangClear(origin, targetPos)
            if not cfg.wallbangCheck then return true end
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.IgnoreWater = true
            local filter = {}
            if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
            if _G.vanz.Runtime.Target and _G.vanz.Runtime.Target.Character then
                table.insert(filter, _G.vanz.Runtime.Target.Character)
            end
            params.FilterDescendantsInstances = filter
            local hit = workspace:Raycast(origin, targetPos - origin, params)
            if not hit then return true end
            local soft = cfg.wallbangSoftMats
            if soft then
                for _, m in ipairs(soft) do
                    if hit.Material == m then return true end
                end
            end
            return false
        end

        -- 8-point Catmull-Rom spline
        local function SplineRefine(plr, part, t)
            if not cfg.splineInterp then return part.Position end
            local tr = _G.vanz.Runtime.VelTracker[plr]
            if not tr or #tr.samples < 8 then return part.Position end
            local n = #tr.samples
            local p1 = tr.samples[n-4].pos
            local p2 = tr.samples[n-3].pos
            local p3 = tr.samples[n-2].pos
            local p4 = tr.samples[n-1].pos
            local p5 = tr.samples[n].pos
            local dt = math.max(tr.samples[n].t - tr.samples[n-1].t, 0.001)
            local u = math.clamp(t / math.max(dt, 0.001), 0, 1)
            local function CR(a,b,c,d,u)
                return 0.5 * ((2*b) + (-a+c)*u + (2*a-5*b+4*c-d)*u*u + (-a+3*b-3*c+d)*u*u*u)
            end
            -- 2 segmen CR: (p1..p4) lalu (p2..p5), blend
            local s1 = Vector3.new(
                CR(p1.X,p2.X,p3.X,p4.X,u),
                CR(p1.Y,p2.Y,p3.Y,p4.Y,u),
                CR(p1.Z,p2.Z,p3.Z,p4.Z,u))
            local s2 = Vector3.new(
                CR(p2.X,p3.X,p4.X,p5.X,u),
                CR(p2.Y,p3.Y,p4.Y,p5.Y,u),
                CR(p2.Z,p3.Z,p4.Z,p5.Z,u))
            return s1:Lerp(s2, u)
        end

        local function PredictTargetPos(origin, rawTarget, velocity, accel,
                                        isJumping, tgtPlr, tgtPart)
            if not cfg.leadPrediction then
                return rawTarget, 0, GetBulletSpeed()
            end

            local speed      = GetBulletSpeed()
            local iterations = GetEffectiveIterations()

            -- ping lead + trend
            local pingBonus = cfg.pingLeadEnabled
                and (cfg.cachedPing or 0) * (cfg.pingLeadScale or 1.0)
                or 0
            if cfg.pingTrendEnabled then
                local trend = cfg.pingTrendEMA or 0
                local tp = math.clamp(
                    trend * (cfg.pingTrendScale or 0.45),
                    -(cfg.pingTrendClamp or 0.055),
                     (cfg.pingTrendClamp or 0.055))
                pingBonus = pingBonus + math.max(tp, 0)
            end
            if _G.vanz.Runtime.PingSpike then
                pingBonus = math.max(pingBonus - (cfg.pingRollbackBuf or 0.035), 0)
            end

            -- movement class weight
            local moveClass = _G.vanz.GetMoveClass and _G.vanz.GetMoveClass(tgtPlr) or "idle"
            local classW = 1.0
            if cfg.movementClassify then
                if moveClass == "sprint" then classW = cfg.classWeightSprint or 1.35
                elseif moveClass == "run" then classW = cfg.classWeightRun or 1.15
                elseif moveClass == "walk" then classW = cfg.classWeightWalk or 0.85
                else classW = cfg.classWeightIdle or 0.55 end
            end

            -- strafe comp + pattern predict
            local strafeVec = Vector3.zero
            if cfg.strafeComp and velocity.Magnitude > 2 then
                local toTarget = rawTarget - origin
                local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
                if flat.Magnitude > 0.1 then
                    local fwd = flat.Unit
                    local right = Vector3.new(-fwd.Z, 0, fwd.X)
                    local lateral = velocity:Dot(right)
                    strafeVec = right * (lateral * (cfg.strafeScale or 0.70))
                    -- strafe pattern: kalau target gerak kiri-kanan pola,
                    -- boost prediksi ke arah kebalikan strafe terakhir
                    if cfg.strafePatternDetect then
                        local conf = _G.vanz.GetStrafeConfidence
                            and _G.vanz.GetStrafeConfidence(tgtPlr) or 0
                        local sign = _G.vanz.GetStrafeSign
                            and _G.vanz.GetStrafeSign(tgtPlr) or 0
                        if conf > (cfg.strafePatternConf or 0.55) and sign ~= 0 then
                            strafeVec = strafeVec + right * (-sign) * 3.0 * conf
                        end
                    end
                end
            end

            -- angular velocity
            local angOffset = Vector3.zero
            if cfg.angularComp and _G.vanz.GetAngularVel then
                local av = _G.vanz.GetAngularVel(tgtPlr)
                if av.Magnitude > 0.05 and tgtPart and tgtPlr.Character then
                    local hrp = tgtPlr.Character:FindFirstChild("HumanoidRootPart")
                    local r = tgtPart.Position
                        - (hrp and hrp.Position or origin)
                    angOffset = av:Cross(r) * (cfg.angularWeight or 0.28)
                end
            end

            -- turn predict: kalau target belok cepat, ekstrapolasi arah hadap
            if cfg.turnPredict and tgtPlr and tgtPlr.Character then
                local hrp = tgtPlr.Character:FindFirstChild("HumanoidRootPart")
                local av = _G.vanz.GetAngularVel and _G.vanz.GetAngularVel(tgtPlr)
                if hrp and av and av.Magnitude > 1.5 then
                    local fwd = hrp.CFrame.LookVector
                    local turnDir = av.Unit
                    angOffset = angOffset + turnDir
                        * av.Magnitude * (cfg.turnPredictScale or 0.35)
                end
            end

            local useAccel = cfg.accelPrediction and accel and accel.Magnitude > 0.5
            local accelW   = cfg.accelWeight or 0.60
            local maxT     = cfg.maxPredictT or 1.20
            local minT     = cfg.minPredictT or 0.02
            local predicted, flightTime = rawTarget, 0

            -- MAIN ITERATION
            for _ = 1, iterations do
                local dist = (predicted - origin).Magnitude
                flightTime = dist / math.max(speed, 1)
                local t = math.clamp((flightTime + pingBonus) * classW, minT, maxT)
                local lin = rawTarget + velocity * t
                if useAccel then lin = lin + accel * (accelW * t * t) end
                lin = lin + strafeVec * math.min(t, 0.4)
                lin = lin + angOffset * math.min(t, 0.6)
                predicted = lin
            end

            -- NEWTON-RAFINEMENT
            local refineN = cfg.refineIterations or 64
            for _ = 1, refineN do
                local d = predicted - origin
                local dist = d.Magnitude
                if dist < 0.01 then break end
                local tNew = dist / math.max(speed, 1)
                local t = math.clamp((tNew + pingBonus) * classW, minT, maxT)
                local lin = rawTarget + velocity * t
                if useAccel then lin = lin + accel * (accelW * t * t) end
                lin = lin + strafeVec * math.min(t, 0.4)
                lin = lin + angOffset * math.min(t, 0.6)
                predicted = predicted:Lerp(lin, 0.5)
            end

            -- SPLINE
            if cfg.splineInterp and tgtPlr and tgtPart then
                local spr = SplineRefine(tgtPlr, tgtPart,
                    math.min((flightTime + pingBonus) * classW, maxT))
                local w = cfg.splineWeight or 0.35
                predicted = predicted:Lerp(spr, w)
            end

            -- JUMP AIR PREDICT
            if cfg.jumpAirPred and isJumping then
                -- saat airborne, kurangi lead horizontal karena gerak XZ lebih stabil
                local w = cfg.jumpPenalty or 0.55
                predicted = Vector3.new(
                    rawTarget.X + (predicted.X - rawTarget.X) * w,
                    predicted.Y,
                    rawTarget.Z + (predicted.Z - rawTarget.Z) * w)
            end

            return predicted, flightTime, speed
        end

        local function GetTargetDir()
            local origin = GetAimOrigin()
            local part   = GetTargetPart()
            local tgtPlr = _G.vanz.Runtime.Target
            if not (origin and part) then return nil, nil end

            local rawTarget = part.Position
            local velocity, accel = GetTargetVelAccel(tgtPlr, part)
            local isJumping = _G.vanz.IsPlayerJumping
                and _G.vanz.IsPlayerJumping(tgtPlr) or false

            if not HasLineOfSight(origin, rawTarget) then return nil, nil end
            if not IsWallbangClear(origin, rawTarget) then return nil, nil end

            local predicted, flightTime = PredictTargetPos(
                origin, rawTarget, velocity, accel, isJumping, tgtPlr, part)

            local diff = predicted - origin
            if diff.Magnitude < 0.01 then return nil, nil end

            local dir = diff.Unit
            return dir, predicted, flightTime
        end

        local function GetFireRemote()
            for _, path in ipairs(cfg.fireRemotePaths or {}) do
                local cur = RS
                local ok = true
                for _, seg in ipairs(path) do
                    cur = cur:FindFirstChild(seg)
                    if not cur then ok = false; break end
                end
                if ok and cur and cur:IsA("RemoteEvent") then return cur end
            end
            return nil
        end

        -- Recoil pattern tracker
        _G.vanz.Runtime.RecoilHistory = _G.vanz.Runtime.RecoilHistory or {}
        _G.vanz.Runtime.LastShotT     = 0
        _G.vanz.Runtime.LastDir       = nil

        local function RecordShot(dir)
            if not cfg.recoilComp then return end
            local now = tick()
            local delta = now - (_G.vanz.Runtime.LastShotT or 0)
            if delta > 1.5 then
                _G.vanz.Runtime.RecoilHistory = {}
            end
            _G.vanz.Runtime.LastShotT = now
            table.insert(_G.vanz.Runtime.RecoilHistory, dir)
            local win = 8
            while #_G.vanz.Runtime.RecoilHistory > win do
                table.remove(_G.vanz.Runtime.RecoilHistory, 1)
            end
        end

        local function ApplyRecoilComp(dir)
            if not cfg.recoilComp then return dir end
            local hist = _G.vanz.Runtime.RecoilHistory
            if #hist < 2 then return dir end
            local drift = Vector3.zero
            for i = 2, #hist do
                drift = drift + (hist[i] - hist[i-1])
            end
            drift = drift / (#hist - 1)
            return (dir - drift * (cfg.recoilScale or 0.60)).Unit
        end

        local _singleFire = function()
            local gun  = GetGunPart()
            local fire = GetFireRemote()
            local dir, _ = GetTargetDir()

            local conf = _G.vanz.Runtime.Confidence or 0
            local gate = cfg.confidenceGate or 0.40
            if conf < gate then return false end
            if not (gun and fire and dir) then return false end

            -- Adaptive smooth by distance
            if cfg.aimSmoothing and _G.vanz.Runtime.LastDir then
                local tgt = _G.vanz.Runtime.Target
                local nearAlpha = cfg.smoothAlphaNear or 0.90
                local farAlpha  = cfg.smoothAlphaFar  or 0.55
                local split     = cfg.smoothDistSplit or 30
                local alpha = farAlpha
                if tgt and tgt.Character then
                    local hrp = tgt.Character:FindFirstChild("HumanoidRootPart")
                    local myChar = LocalPlayer.Character
                    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                    if hrp and myHrp then
                        local d = (hrp.Position - myHrp.Position).Magnitude
                        if d <= split then alpha = nearAlpha
                        else
                            local t = math.clamp((d - split) / 200, 0, 1)
                            alpha = nearAlpha + (farAlpha - nearAlpha) * t
                        end
                    end
                end
                dir = _G.vanz.Runtime.LastDir:Lerp(dir, alpha)
            end

            dir = ApplyRecoilComp(dir)
            _G.vanz.Runtime.LastDir = dir
            RecordShot(dir)

            local ok = pcall(function() fire:FireServer(gun, dir) end)
            return ok
        end

        _G.vanz.FireTof = function()
            if not cfg.burstFire then _singleFire(); return end
            task.spawn(function()
                for i = 1, (cfg.burstCount or 5) do
                    _singleFire()
                    if i < (cfg.burstCount or 5) then
                        task.wait(cfg.burstGap or 0.030)
                    end
                end
            end)
        end

        _G.vanz.Events.FireButton = function(en)
            if _G.vanz.Runtime.FireButton then
                _G.vanz.Runtime.FireButton.Visible = en
            end
        end
        _G.vanz.Events.LeadPredict = function(en)
            cfg.leadPrediction = en
        end

        print("[VANZ] FireTof v13 READY (128-iter / 64-refine / 8pt-spline / class+strafe+turn).")
    end, function(err)
        warn(string.format("[VANZ ERROR][6_FIRETOF] %s\n%s",
            tostring(err), debug.traceback("", 2)))
    end)
end

