--========================================================--
-- 2_FPS_MONITOR v13
--========================================================--
do
    xpcall(function()
        local RunService  = game:GetService("RunService")
        local Players     = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer

        _G.vanz.Runtime.SmoothFPS     = 60
        _G.vanz.Runtime.FrameTimeAcc  = 0
        _G.vanz.Runtime.FrameCount    = 0
        _G.vanz.Runtime.LastFPSSample = tick()
        _G.vanz.Runtime.PingJitterEMA = 0
        _G.vanz.Runtime.PingSpike     = false
        _G.vanz.Runtime.LastPing      = 0.05

        RunService.Heartbeat:Connect(function(dt)
            local now = tick()
            _G.vanz.Runtime.FrameTimeAcc = _G.vanz.Runtime.FrameTimeAcc + dt
            _G.vanz.Runtime.FrameCount   = _G.vanz.Runtime.FrameCount + 1

            if now - _G.vanz.Runtime.LastFPSSample >= 0.10 then
                local avgDt = _G.vanz.Runtime.FrameTimeAcc / math.max(_G.vanz.Runtime.FrameCount, 1)
                local fps = 1 / math.max(avgDt, 0.001)
                _G.vanz.Runtime.SmoothFPS = _G.vanz.Runtime.SmoothFPS * 0.94 + fps * 0.06
                _G.vanz.Runtime.FrameTimeAcc = 0
                _G.vanz.Runtime.FrameCount   = 0
                _G.vanz.Runtime.LastFPSSample = now

                pcall(function()
                    local ping = LocalPlayer:GetNetworkPing()
                    if typeof(ping) == "number" and ping > 0 then
                        local cfg = _G.vanz.AimCfg
                        local prev = cfg.cachedPing or 0.05
                        cfg.cachedPing = prev * 0.82 + ping * 0.18
                        local delta = ping - (_G.vanz.Runtime.LastPing or ping)
                        cfg.pingTrendEMA = (cfg.pingTrendEMA or 0) * 0.78 + delta * 0.22
                        _G.vanz.Runtime.LastPing = ping
                        local jitter = math.abs(ping - prev)
                        _G.vanz.Runtime.PingJitterEMA =
                            _G.vanz.Runtime.PingJitterEMA * 0.70 + jitter * 0.30
                        _G.vanz.Runtime.PingSpike =
                            ping > (cfg.pingSpikeGate or 0.140)
                    end
                end)
            end
        end)

        print("[VANZ] FPS monitor v13 READY.")
    end, function(err)
        warn(string.format("[VANZ ERROR][2_FPS_MONITOR] %s\n%s",
            tostring(err), debug.traceback("", 2)))
    end)
end

