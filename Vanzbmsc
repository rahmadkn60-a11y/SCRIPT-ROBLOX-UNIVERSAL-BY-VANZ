--========================================================--
do
    xpcall(function()
        local Players     = game:GetService("Players")
        local RunService  = game:GetService("RunService")
        local LocalPlayer = Players.LocalPlayer

        local function Classify(plr)
            if not plr or plr == LocalPlayer then return "self" end
            local team = plr.Team
            if not team then return "unknown" end
            local cfg  = _G.vanz.TeamCfg
            local name = string.lower(team.Name or "")
            for _, kw in ipairs(cfg.enemyKeywords) do
                if string.find(name, kw, 1, true) then return "enemy" end
            end
            for _, kw in ipairs(cfg.allyKeywords) do
                if string.find(name, kw, 1, true) then return "ally" end
            end
            local tc = team.TeamColor
            local c  = tc and tc.Color
            if c then
                if c.R >= cfg.enemyR and c.G < 0.45 and c.B < 0.45 then return "enemy" end
                if c.B >= cfg.allyB then return "ally" end
            end
            return "unknown"
        end

        local function GetRoot(plr)
            local char = plr and plr.Character
            if not char then return nil end
            return char:FindFirstChild("UpperTorso")
                or char:FindFirstChild("HumanoidRootPart")
                or char:FindFirstChild("Torso")
        end

        _G.vanz.Runtime.LastSwitch = 0
        _G.vanz.Runtime.Confidence = 0
        _G.vanz.Runtime.TrackAge   = {}
        _G.vanz.Runtime.ThreatMap  = {}
        _G.vanz.Runtime.LockUntil  = 0

        if _G.vanz.Runtime.ScanConn then _G.vanz.Runtime.ScanConn:Disconnect() end

        _G.vanz.Runtime.ScanConn = RunService.RenderStepped:Connect(function()
            if not (_G.vanz.Settings.VisualLine or _G.vanz.Settings.FireButton) then return end

            local myRoot = GetRoot(LocalPlayer)
            if not myRoot then
                _G.vanz.Runtime.Target = nil
                _G.vanz.Runtime.Confidence = 0
                return
            end

            local cam   = workspace.CurrentCamera
            local myPos = myRoot.Position
            local cfg   = _G.vanz.AimCfg
            local maxD  = cfg.maxScanDistance or 3000
            local bestScore, best = -math.huge, nil
            local now   = tick()

            for _, plr in ipairs(Players:GetPlayers()) do
                if Classify(plr) == "enemy" then
                    local root = GetRoot(plr)
                    if root then
                        local d = (root.Position - myPos).Magnitude
                        if d <= maxD then
                            local score = -(d / maxD)
                            if cam then
                                local sp = cam:WorldToViewportPoint(root.Position)
                                if sp.Z > 0 then
                                    local vp = cam.ViewportSize
                                    local dx = sp.X - vp.X * 0.5
                                    local dy = sp.Y - vp.Y * 0.5
                                    local ang = math.sqrt(dx*dx + dy*dy)
                                    local maxAng = math.sqrt(vp.X*vp.X + vp.Y*vp.Y) * 0.5
                                    score = score + (1 - ang / maxAng) * 0.5
                                else
                                    score = score - 0.4
                                end
                            end

                            if cfg.threatScoring then
                                local hum = plr.Character
                                    and plr.Character:FindFirstChildOfClass("Humanoid")
                                local hpRatio = 1
                                if hum and hum.MaxHealth > 0 then
                                    hpRatio = hum.Health / hum.MaxHealth
                                end
                                local velScore = 0
                                if _G.vanz.GetPlayerSpeed then
                                    velScore = math.clamp(
                                        _G.vanz.GetPlayerSpeed(plr) / 30, 0, 1)
                                end
                                score = score
                                    + (1 - hpRatio) * (cfg.threatHPWeight or 0.35)
                                    + (1 - d / maxD) * (cfg.threatDistWeight or 0.35)
                                    + velScore * (cfg.threatVelWeight or 0.20)
                                _G.vanz.Runtime.ThreatMap[plr] = 1 - hpRatio
                            end

                            local age = (_G.vanz.Runtime.TrackAge[plr] or 0)
                            score = score + math.min(age, 2) * (cfg.momentumWeight or 0.45)

                            if score > bestScore then
                                bestScore, best = score, plr
                            end
                        end
                    end
                end
            end

            local prev = _G.vanz.Runtime.Target
            if cfg.priorityLock and prev and now < (_G.vanz.Runtime.LockUntil or 0) then
                local prevRoot = GetRoot(prev)
                if prevRoot then
                    local prevScore = -((prevRoot.Position - myPos).Magnitude / maxD)
                    local age = (_G.vanz.Runtime.TrackAge[prev] or 0)
                    prevScore = prevScore + math.min(age, 2) * (cfg.momentumWeight or 0.45)
                    if bestScore < prevScore * (cfg.lockThreshold or 2.8) then
                        best = prev
                    else
                        _G.vanz.Runtime.LockUntil = now + (cfg.lockTimeout or 2.5)
                    end
                end
            end

            local hs = cfg.switchHysteresis or 0.25
            if prev and best and prev ~= best
            and (now - (_G.vanz.Runtime.LastSwitch or 0)) < hs then
                best = prev
            elseif prev ~= best then
                _G.vanz.Runtime.LastSwitch = now
                _G.vanz.Runtime.LockUntil  = now + (cfg.lockTimeout or 2.5)
            end

            for plr in pairs(_G.vanz.Runtime.TrackAge) do
                if plr ~= best then
                    _G.vanz.Runtime.TrackAge[plr] = math.max(0,
                        (_G.vanz.Runtime.TrackAge[plr] or 0) - 0.05)
                end
            end
            if best then
                _G.vanz.Runtime.TrackAge[best] = (_G.vanz.Runtime.TrackAge[best] or 0) + 0.02
            end

            _G.vanz.Runtime.Target = best

            if best then
                local root = GetRoot(best)
                if root and cam then
                    local d = (root.Position - myPos).Magnitude
                    local distConf = math.clamp(1 - (d / maxD), 0, 1)
                    local sp = cam:WorldToViewportPoint(root.Position)
                    local angConf = 1
                    if sp.Z > 0 then
                        local vp = cam.ViewportSize
                        local dx, dy = sp.X - vp.X * 0.5, sp.Y - vp.Y * 0.5
                        local ang = math.sqrt(dx*dx + dy*dy)
                        local maxAng = math.sqrt(vp.X*vp.X + vp.Y*vp.Y) * 0.5
                        angConf = math.clamp(1 - ang / maxAng, 0, 1)
                    end
                    _G.vanz.Runtime.Confidence = distConf * 0.4 + angConf * 0.6
                else
                    _G.vanz.Runtime.Confidence = 0
                end
            else
                _G.vanz.Runtime.Confidence = 0
            end
        end)

        print("[VANZ] TargetScan v13 READY.")
    end, function(err)
        warn(string.format("[VANZ ERROR][3_TARGET_SCAN] %s\n%s",
            tostring(err), debug.traceback("", 2)))
    end)
end

--========================================================--
-- 4_VELOCITY_TRACKER v13 (Kalman 2nd + movement class + strafe pattern)
--========================================================--
do
    xpcall(function()
        local Players    = game:GetService("Players")
        local RunService = game:GetService("RunService")

        _G.vanz.Runtime.VelTracker = _G.vanz.Runtime.VelTracker or {}

        local SAMPLE_WINDOW = 0.004
        local MAX_SAMPLES   = 500
        local SMOOTH_ALPHA  = 0.95
        local ACCEL_ALPHA   = 0.78
        local JUMP_Y_THRESH = 14
        local STATIC_EPS    = 0.010

        local function GetRoot(plr)
            local char = plr and plr.Character
            if not char then return nil end
            return char:FindFirstChild("HumanoidRootPart")
                or char:FindFirstChild("UpperTorso")
                or char:FindFirstChild("Torso")
        end

        -- Kalman 1D
        local function KalmanStep(s, meas, dt, q, r)
            local xPred = s.x + s.vx * dt
            local pPred = s.p + q
            local k = pPred / (pPred + r)
            local xNew = xPred + k * (meas - xPred)
            local vNew = s.vx + (xNew - s.x) / math.max(dt, 0.001) * 0.30
            s.x = xNew
            s.vx = vNew
            s.p = (1 - k) * pPred
            return s
        end

        local function ClassifyMovement(speed)
            local cfg = _G.vanz.AimCfg
            if speed >= (cfg.sprintThreshold or 22) then return "sprint" end
            if speed >= (cfg.walkThreshold or 8)    then return "run" end
            if speed >= 0.5                          then return "walk" end
            return "idle"
        end

        -- Deteksi pola strafe (kiri-kanan berulang)
        local function UpdateStrafePattern(tr, lateral, now)
            tr.lateralHistory = tr.lateralHistory or {}
            table.insert(tr.lateralHistory, { t = now, v = lateral })
            local win = _G.vanz.AimCfg.strafePatternWindow or 1.2
            while #tr.lateralHistory > 0
                and (now - tr.lateralHistory[1].t) > win do
                table.remove(tr.lateralHistory, 1)
            end
            if #tr.lateralHistory < 6 then
                tr.strafeConfidence = 0
                return
            end
            -- hitung jumlah sign-flip
            local flips = 0
            local prevSign = 0
            for _, s in ipairs(tr.lateralHistory) do
                local sgn = s.v > 0.5 and 1 or (s.v < -0.5 and -1 or 0)
                if sgn ~= 0 then
                    if prevSign ~= 0 and sgn ~= prevSign then flips = flips + 1 end
                    prevSign = sgn
                end
            end
            local conf = math.clamp(flips / math.max(#tr.lateralHistory - 1, 1), 0, 1)
            tr.strafeConfidence = conf
            tr.strafeLastSign   = prevSign
        end

        local function Sample(plr, maxDist, myPos)
            local root = GetRoot(plr)
            if not root then return end

            if maxDist and myPos then
                local d = (root.Position - myPos).Magnitude
                if d > maxDist then
                    _G.vanz.Runtime.VelTracker[plr] = nil
                    return
                end
            end

            local now  = tick()
            local pos  = root.Position
            local vel  = root.AssemblyLinearVelocity or root.Velocity or Vector3.zero
            local cfr  = root.CFrame
            local look = cfr and cfr.LookVector or Vector3.zero

            local tr = _G.vanz.Runtime.VelTracker[plr]
            if not tr then
                tr = {
                    samples        = {},
                    smoothVel      = Vector3.zero,
                    smoothAccel    = Vector3.zero,
                    kalmanX        = { x = pos.X, vx = 0, p = 0.5 },
                    kalmanY        = { x = pos.Y, vx = 0, p = 0.5 },
                    kalmanZ        = { x = pos.Z, vx = 0, p = 0.5 },
                    lastLook       = look,
                    angularVel     = Vector3.zero,
                    lastSpeed      = 0,
                    lastPos        = pos,
                    lastVel        = vel,
                    lastSampleT    = now,
                    unchangedCount = 0,
                    isJumping      = false,
                    jumpUntil      = 0,
                    moveClass      = "idle",
                    strafeConfidence = 0,
                    strafeLastSign = 0,
                }
                _G.vanz.Runtime.VelTracker[plr] = tr
            end

            if (pos - tr.lastPos).Magnitude < STATIC_EPS then
                tr.unchangedCount = tr.unchangedCount + 1
                if tr.unchangedCount > 5 then
                    tr.smoothVel   = Vector3.zero
                    tr.smoothAccel = Vector3.zero
                    tr.lastSpeed   = 0
                    tr.lastPos     = pos
                    tr.lastSampleT = now
                    tr.moveClass   = "idle"
                    return
                end
            else
                tr.unchangedCount = 0
            end
            tr.lastPos = pos

            local dt = now - tr.lastSampleT
            if dt > 0.001 then
                local instAccel = (vel - tr.lastVel) / dt
                local clamp = _G.vanz.AimCfg.accelClamp or 350
                if instAccel.Magnitude > clamp then
                    instAccel = instAccel.Unit * clamp
                end
                tr.smoothAccel = tr.smoothAccel:Lerp(instAccel, ACCEL_ALPHA)

                if look.Magnitude > 0.01 and tr.lastLook.Magnitude > 0.01 then
                    local dLook = look - tr.lastLook
                    local instAng = dLook / dt
                    tr.angularVel = tr.angularVel:Lerp(instAng, 0.72)
                end
            end
            tr.lastVel     = vel
            tr.lastLook    = look
            tr.lastSampleT = now

            if _G.vanz.AimCfg.kalmanFilter then
                local q = _G.vanz.AimCfg.kalmanQ or 0.006
                local r = _G.vanz.AimCfg.kalmanR or 0.10
                KalmanStep(tr.kalmanX, pos.X, dt, q, r)
                KalmanStep(tr.kalmanY, pos.Y, dt, q, r)
                KalmanStep(tr.kalmanZ, pos.Z, dt, q, r)
            end

            if _G.vanz.AimCfg.jumpDetect and vel.Y > JUMP_Y_THRESH then
                tr.isJumping = true
                tr.jumpUntil = now + 1.0
            elseif tr.jumpUntil and now > tr.jumpUntil then
                tr.isJumping = false
            end

            table.insert(tr.samples, { t = now, pos = pos })
            while #tr.samples > MAX_SAMPLES do
                table.remove(tr.samples, 1)
            end
            while #tr.samples > 2
            and (now - tr.samples[1].t) > SAMPLE_WINDOW do
                table.remove(tr.samples, 1)
            end

            if #tr.samples >= 2 then
                local oldest = tr.samples[1]
                local newest = tr.samples[#tr.samples]
                local wdt = newest.t - oldest.t
                if wdt > 0.001 then
                    local instVel = (newest.pos - oldest.pos) / wdt
                    tr.smoothVel = tr.smoothVel:Lerp(instVel, SMOOTH_ALPHA)
                    tr.lastSpeed = tr.smoothVel.Magnitude
                    tr.moveClass = ClassifyMovement(tr.lastSpeed)
                end
            end

            -- lateral strafe detect (perpendicular ke arah kamera)
            if _G.vanz.AimCfg.strafePatternDetect and tr.smoothVel.Magnitude > 1 then
                local cam = workspace.CurrentCamera
                if cam then
                    local cf = cam.CFrame
                    local fwd = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
                    if fwd.Magnitude > 0.1 then
                        fwd = fwd.Unit
                        local right = Vector3.new(-fwd.Z, 0, fwd.X)
                        local lat = tr.smoothVel:Dot(right)
                        UpdateStrafePattern(tr, lat, now)
                    end
                end
            end
        end

        if _G.vanz.Runtime.VelConn then _G.vanz.Runtime.VelConn:Disconnect() end

        _G.vanz.Runtime.VelConn = RunService.RenderStepped:Connect(function()
            if not (_G.vanz.Settings.VisualLine
                 or _G.vanz.Settings.FireButton
                 or _G.vanz.Settings.LeadPredict) then return end
            local lp = Players.LocalPlayer
            local myChar = lp.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local myPos  = myRoot and myRoot.Position
            local maxDist = _G.vanz.AimCfg.maxScanDistance or 3000
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= lp then Sample(plr, maxDist, myPos) end
            end
        end)

        _G.vanz.SampleNow = function(plr)
            if not plr then return end
            local lp = Players.LocalPlayer
            local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            local myPos = myRoot and myRoot.Position
            Sample(plr, nil, myPos)
        end

        _G.vanz.GetPlayerVelocity = function(plr)
            if not plr then return Vector3.zero end
            local tr = _G.vanz.Runtime.VelTracker[plr]
            if not tr then return Vector3.zero end
            if _G.vanz.AimCfg.kalmanFilter then
                return Vector3.new(tr.kalmanX.vx, tr.kalmanY.vx, tr.kalmanZ.vx)
            end
            return tr.smoothVel or Vector3.zero
        end

        _G.vanz.GetPlayerAccel = function(plr)
            if not plr then return Vector3.zero end
            local tr = _G.vanz.Runtime.VelTracker[plr]
            return tr and tr.smoothAccel or Vector3.zero
        end

        _G.vanz.GetAngularVel = function(plr)
            if not plr then return Vector3.zero end
            local tr = _G.vanz.Runtime.VelTracker[plr]
            return tr and tr.angularVel or Vector3.zero
        end

        _G.vanz.GetMoveClass = function(plr)
            local tr = _G.vanz.Runtime.VelTracker[plr]
            return tr and tr.moveClass or "idle"
        end

        _G.vanz.GetStrafeConfidence = function(plr)
            local tr = _G.vanz.Runtime.VelTracker[plr]
            return tr and tr.strafeConfidence or 0
        end

        _G.vanz.GetStrafeSign = function(plr)
            local tr = _G.vanz.Runtime.VelTracker[plr]
            return tr and tr.strafeLastSign or 0
        end

        _G.vanz.IsPlayerJumping = function(plr)
            local tr = _G.vanz.Runtime.VelTracker[plr]
            return tr and tr.isJumping or false
        end

        _G.vanz.GetPlayerSpeed = function(plr)
            return _G.vanz.GetPlayerVelocity(plr).Magnitude
        end

        print(string.format(
            "[VANZ] VelTracker v13: window=%.4fs samples=%d kalman2=on class=on strafe=on",
            SAMPLE_WINDOW, MAX_SAMPLES))
    end, function(err)
        warn(string.format("[VANZ ERROR][4_VELOCITY_TRACKER] %s\n%s",
            tostring(err), debug.traceback("", 2)))
    end)
end

