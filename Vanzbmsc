                if ra then
                    local m = ra:FindFirstChild("gun")
                        or ra:FindFirstChildWhichIsA("BasePart", true)
                    if m and m:IsA("BasePart") then return m.Position end
                end
            end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            return hrp and (hrp.Position + Vector3.new(0,1,0)) or nil
        end

