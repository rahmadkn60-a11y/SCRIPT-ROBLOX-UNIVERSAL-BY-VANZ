            local gunPos = GetGunPos()
            local cam = workspace.CurrentCamera
            if not (gunPos and cam) then
                line.Visible = false; dot.Visible = false; rawDot.Visible = false
                return
            end
            line.From = Project(gunPos, cam)
            line.To   = Project(part.Position, cam)
            line.Visible = true
            local conf = _G.vanz.Runtime.Confidence or 0
            dot.Color = Color3.fromRGB(
                math.floor(255 * (1 - conf)),
                math.floor(255 * conf), 60)
            dot.Position = Project(part.Position, cam)
            dot.Visible = true
            rawDot.Position = Project(part.Position, cam)
            rawDot.Visible = _G.vanz.AimCfg.leadPrediction
        end)

        _G.vanz.Events.VisualLine = function(en)
