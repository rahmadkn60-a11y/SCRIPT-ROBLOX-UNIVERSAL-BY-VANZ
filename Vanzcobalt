            nameLbl.Font = Enum.Font.Gotham
            nameLbl.Text = entry.name
            nameLbl.TextSize = 14
            nameLbl.TextColor3 = C.text
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
            nameLbl.Parent = row

            local pathLbl = Instance.new("TextLabel")
            pathLbl.Position = UDim2.fromOffset(45, 27)
            pathLbl.Size = UDim2.new(1, -100, 0, 16)
            pathLbl.BackgroundTransparency = 1
            pathLbl.Font = Enum.Font.Code
            pathLbl.Text = entry.class
            pathLbl.TextSize = 9
            pathLbl.TextColor3 = C.textDim
            pathLbl.TextXAlignment = Enum.TextXAlignment.Left
            pathLbl.TextTruncate = Enum.TextTruncate.AtEnd
            pathLbl.Parent = row

            local countLbl = Instance.new("TextLabel")
            countLbl.Position = UDim2.new(1, -60, 0, 7)
            countLbl.Size = UDim2.fromOffset(50, 22)
            countLbl.BackgroundTransparency = 1
            countLbl.Font = Enum.Font.Gotham
            countLbl.Text = "x0"
            countLbl.TextSize = 13
            countLbl.TextColor3 = C.textDim
            countLbl.TextXAlignment = Enum.TextXAlignment.Right
            countLbl.Parent = row

            row.MouseButton1Click:Connect(function()
                for _, r in pairs(rows) do
                    r.row.BackgroundColor3 = C.row
                end
                row.BackgroundColor3 = C.rowSel
                V.State.selected = entry
                V.selectEntry(entry)
            end)

            return { row = row, countLbl = countLbl, entry = entry }
        end

        -- SELECT ENTRY (update right panel)
        function V.selectEntry(entry)
            V.State.selected = entry
            setStatus("Selected: " .. entry.name, C.text)

            local calls = entry.calls or {}
            local latest = calls[#calls]

            if not latest then
                argBox.Text = "-- Belum ada argument"
                codeBox.Text = "-- Belum ada call"
                infoBox.Text = "-- Belum ada call"
                return
            end

            -- ARGS
            local lines = {}
            if #latest.args == 0 then
                lines[#lines+1] = "-- no arguments"
            else
                for i, v in ipairs(latest.args) do
                    lines[#lines+1] = string.format("%d  %s", i, V.shortPreview(v))
                end
            end
            argBox.Text = table.concat(lines, "\n")

            -- CODE
            local codeLines = {}
            codeLines[#codeLines+1] = "-- Generated by VANZ Cobalt"
            codeLines[#codeLines+1] = "-- Remote: " .. entry.path
            codeLines[#codeLines+1] = "-- Method: " .. latest.method
            codeLines[#codeLines+1] = ""
            codeLines[#codeLines+1] = "local Event = " .. V.pathToCode(entry.path)
            codeLines[#codeLines+1] = ""
            if #latest.args == 0 then
                codeLines[#codeLines+1] = "Event:" .. latest.method .. "()"
            else
                codeLines[#codeLines+1] = "Event:" .. latest.method .. "("
                for i, v in ipairs(latest.args) do
                    local code = V.toCode(v, "    ")
                    local sep = (i < #latest.args) and "," or ""
                    codeLines[#codeLines+1] = "    " .. code .. sep
                end
                codeLines[#codeLines+1] = ")"
            end
            local codeStr = table.concat(codeLines, "\n")
            codeBox.Text = codeStr
            V.State.codeCache = codeStr

            -- INFO
            local infoLines = {}
            infoLines[#infoLines+1] = "Function Info"
            infoLines[#infoLines+1] = ""
            infoLines[#infoLines+1] = "Name        : " .. entry.name
            infoLines[#infoLines+1] = "Path        : " .. entry.path
            infoLines[#infoLines+1] = "Class       : " .. entry.class
            infoLines[#infoLines+1] = "Method      : " .. latest.method
            infoLines[#infoLines+1] = "Time        : " .. latest.time
            infoLines[#infoLines+1] = "Args count  : " .. #latest.args
            infoLines[#infoLines+1] = "Total calls : " .. #calls
            infoBox.Text = table.concat(infoLines, "\n")
        end

        -- HOOK CALLBACKS
        function V.onRemoteNew(entry)
            local r = buildRow(entry)
            rows[entry] = r
            if not V.State.selected then
                r.row.BackgroundColor3 = C.rowSel
                V.State.selected = entry
                V.selectEntry(entry)
            end
        end

        function V.onRemoteUpdate(entry)
            local r = rows[entry]
            if r then r.countLbl.Text = "x" .. #entry.calls end
            if V.State.selected == entry then
                V.selectEntry(entry)
            end
        end

        -- TAB SWITCH
        local function showTab(tab)
            argBox.Visible  = (tab == "args")
            codeBox.Visible = (tab == "code")
            infoBox.Visible = (tab == "info")
            for name, btn in pairs({args = V.UI.argsTab, code = V.UI.codeTab, info = V.UI.infoTab}) do
                local active = (name == tab)
                btn.BackgroundColor3 = active and C.rowSel or C.btn
                btn.TextColor3 = active and C.text or Color3.fromRGB(210, 210, 210)
            end
        end
        V.UI.argsTab.MouseButton1Click:Connect(function() showTab("args") end)
        V.UI.codeTab.MouseButton1Click:Connect(function() showTab("code") end)
        V.UI.infoTab.MouseButton1Click:Connect(function() showTab("info") end)
        showTab("args")

        -- COPY
        V.UI.copyBtn.MouseButton1Click:Connect(function()
            local text = codeBox.Text or ""
            if text == "" then setStatus("Kosong", C.textDim); return end
            local fn, name = V.clipboard()
            if fn then
                if pcall(fn, text) then
                    setStatus("Copied ✓ (" .. tostring(name) .. ")", C.good)
                    return
                end
            end
            codeBox:CaptureFocus()
            task.wait(0.05)
            codeBox.CursorPosition = #text + 1
            codeBox.SelectionStart = 1
            setStatus("Auto-select — Ctrl+C", C.yellow)
        end)

        -- RUN
        V.UI.runBtn.MouseButton1Click:Connect(function()
            local code = codeBox.Text or ""
            if code == "" then setStatus("Kosong", C.textDim); return end
            local loader = loadstring or load
            if type(loader) ~= "function" then
                setStatus("No loadstring", C.danger); return
            end
            local fn, err = loader(code)
            if not fn then
                warn("[VANZ RUN] " .. tostring(err))
                setStatus("Parse error", C.danger)
                return
            end
            local ok, e = pcall(fn)
            if ok then
                setStatus("Run OK ✓", C.good)
            else
                warn("[VANZ RUN] " .. tostring(e))
                setStatus("Run error", C.danger)
            end
        end)
    end)
end


