-- BLOCK 5 : CONTROLS (drag, minimize, logo, close)
do
    _G.vanz.run("CONTROLS", function()
        local V = _G.vanz
        local UIS = game:GetService("UserInputService")
        local main = V.UI.main
        local titleBar = V.UI.titleBar
        local minBtn = V.UI.minBtn
        local closeBtn = V.UI.closeBtn
        local logo = V.UI.logo

        -- DRAG VIA TITLE BAR
        local dragging, dragStart, startPos, dragInput

        local function isOverBtn(pos)
            for _, b in ipairs({minBtn, closeBtn}) do
                local ap, as = b.AbsolutePosition, b.AbsoluteSize
                if pos.X >= ap.X and pos.X <= ap.X + as.X
                   and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y then
                    return true
                end
            end
            return false
        end

        titleBar.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
               and input.UserInputType ~= Enum.UserInputType.Touch then return end
            if isOverBtn(input.Position) then return end
            dragging = true
            dragStart = input.Position
            startPos = main.Position
            dragInput = input
        end)
        titleBar.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
               or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if not dragging or input ~= dragInput then return end
            local d = input.Position - dragStart
            main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end)
        UIS.InputEnded:Connect(function(input)
            if input == dragInput then dragging = false end
        end)

        -- MINIMIZE → logo
        minBtn.MouseButton1Click:Connect(function()
            main.Visible = false
            logo.Visible = true
            logo.Position = UDim2.new(0.5, -26, 0.5, -26)
        end)

        -- CLOSE
        closeBtn.MouseButton1Click:Connect(function()
            if V.unhook then V.unhook() end
            V.UI.gui:Destroy()
        end)

        -- LOGO drag + klik restore
        local lDrag, lStart, lPos, lInput, lMoved = false, nil, nil, nil, 0
        logo.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
               and input.UserInputType ~= Enum.UserInputType.Touch then return end
            lDrag = true
            lMoved = 0
            lStart = input.Position
            lPos = logo.Position
            lInput = input
        end)
        logo.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement
               or input.UserInputType == Enum.UserInputType.Touch then
                lInput = input
            end
        end)
        UIS.InputChanged:Connect(function(input)
            if not lDrag or input ~= lInput then return end
            local d = input.Position - lStart
            lMoved = d.Magnitude
            logo.Position = UDim2.new(
                lPos.X.Scale, lPos.X.Offset + d.X,
                lPos.Y.Scale, lPos.Y.Offset + d.Y
            )
        end)
        UIS.InputEnded:Connect(function(input)
            if not lDrag or input ~= lInput then return end
            lDrag = false
            if lMoved < 8 then
                logo.Visible = false
                main.Visible = true
            end
        end)
    end)
end


