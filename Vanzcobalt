    V.State.maxCalls  = 200
    V.State.logBuffer = V.State.logBuffer or {}

    local function errH(err)
        return tostring(err) .. "\n" .. debug.traceback("", 2)
    end
    function V.run(name, fn)
        local ok, r = xpcall(fn, errH)
        if not ok then warn("[VANZ ERROR][" .. name .. "] " .. tostring(r)) end
        return ok, r
    end
    function V.log(...)
        local parts = {}
        for _, v in ipairs({...}) do parts[#parts+1] = tostring(v) end
        print("[VANZ]", table.concat(parts, " "))
    end
end


