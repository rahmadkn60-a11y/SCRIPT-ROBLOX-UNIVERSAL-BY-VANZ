-- BLOCK 2 : HOOK RUNTIME
do
    _G.vanz.run("HOOK", function()
        local V = _G.vanz

        if type(getrawmetatable) ~= "function"
           or type(setreadonly) ~= "function"
           or type(getnamecallmethod) ~= "function" then
            V.hookOK = false
            V.log("hook API tidak tersedia")
            return
        end

        local mt = getrawmetatable(game)
        if not mt or not mt.__namecall then V.hookOK = false; return end
        local oldNC = mt.__namecall
        V.hookOK = true

        local function record(inst, method, args)
            local S = V.State
            local entry = S.byRef[inst]
            if not entry then
                entry = {
                    ref = inst,
                    name = inst.Name,
                    path = inst:GetFullName(),
                    class = inst.ClassName,
                    calls = {},
                }
                S.byRef[inst] = entry
                table.insert(S.remotes, entry)
                if V.onRemoteNew then pcall(V.onRemoteNew, entry) end
            end
            table.insert(entry.calls, {
                method = method,
                args = args,
                time = os.date("%H:%M:%S"),
            })
            while #entry.calls > S.maxCalls do table.remove(entry.calls, 1) end

            if V.onRemoteUpdate then pcall(V.onRemoteUpdate, entry) end
            if S.selected == entry and V.renderRight then
                pcall(V.renderRight, entry)
            end
        end

        local wrapper
        wrapper = function(self, ...)
            if typeof(self) ~= "Instance" then return oldNC(self, ...) end
            local m = getnamecallmethod()
            if m == "FireServer" or m == "InvokeServer" then
                local args = {...}
                pcall(record, self, m, args)
            end
            return oldNC(self, ...)
        end
        if type(newcclosure) == "function" then
            wrapper = newcclosure(wrapper)
        end

        pcall(function()
            setreadonly(mt, false)
            mt.__namecall = wrapper
            setreadonly(mt, true)
        end)

        V._mt = mt
        V._oldNC = oldNC
        function V.unhook()
            pcall(function()
                setreadonly(mt, false)
                mt.__namecall = oldNC
                setreadonly(mt, true)
            end)
        end
    end)
end


